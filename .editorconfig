# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 80

# Solidity files - using tabs as per project preference
[*.sol]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

# Other source files
[*.{js,jsx,ts,tsx,json}]
indent_style = space
indent_size = 2

# Test files can be a bit more lenient with line length
[*{.t.sol,test.sol,spec.ts}]
max_line_length = 100

# Matches the exact files
[*.md]
trim_trailing_whitespace = false
max_line_length = off 